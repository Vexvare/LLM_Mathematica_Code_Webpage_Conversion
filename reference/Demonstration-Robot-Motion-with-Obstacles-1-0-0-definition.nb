Cell[CellGroupData[{

Cell[TextData[{
 "Details & Citations",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"DetailCells", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
         TextData[{
          "This optional section is for a more detailed description of the \
Demonstration than the caption, but it should still be as concise as \
possible. This section may also include numbered snapshot captions (e.g., \
Snapshot 1: phrase or sentence without an initial capital and without a \
period, unless more than one sentence is used) and explanations of the ", 
           StyleBox["Manipulate", "MRbig"], 
           " control labels. Define any symbols undefined so far. Include \
only text in this section \[LongDash] no code, graphics, etc. Do not change \
the cell style or copy cells from other sections. \n\nA book reference uses \
this format: \n   L. D. Schmidt, ", 
           StyleBox[
           "The Engineering of Chemical Reactions", FontSlant -> "Italic"], 
           ", New York: Oxford University Press, 1998. \n\nAn article \
reference uses this format: \n   D. Pearson, \"A Polynomial-Time Algorithm \
for the Change-Making Problem,\" ", 
           StyleBox["Operations Research Letters", FontSlant -> "Italic"], 
           ", ", 
           StyleBox["33", FontWeight -> "Bold"], 
           "(3), 2005 pp. 231\[Dash]234."}], "MoreInfoText"], Background -> 
        GrayLevel[0.95], FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], 
        RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoDetailCells"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "0f840246-dde2-4fd7-a5f5-690c2ecc541f"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "DetailCells"},
 DefaultNewCellStyle->"Text",
 CellTags->{
  "AuthorNotes", "DetailCells", "Details & Citations", "TemplateCellGroup"},
 CellID->441931514,ExpressionUUID->"5c731024-d48b-439e-9713-57c31c11a800"],

Cell[TextData[{
 "The set of all possible configurations of the robot can be represented in a \
two-dimensional ",
 StyleBox["phase space",
  FontSlant->"Italic"],
 ". Of particular interest are the configurations in which the robot collides \
with one of the obstacles."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.6692452298275003`*^9, 3.669245249394539*^9}, {
   3.669245283123629*^9, 3.66924547235503*^9}, {3.669245669765642*^9, 
   3.669245818059637*^9}, {3.6696655654249563`*^9, 3.6696656339232407`*^9}, {
   3.669665674226009*^9, 3.6696657189759073`*^9}, {3.6696657973014107`*^9, 
   3.669665847074965*^9}, 3.6697229519557343`*^9},
 CellID->179276025,ExpressionUUID->"da051ca8-bdf5-47de-aa70-8708b0893d56"],

Cell[TextData[{
 "This Demonstration computes the obstacle regions using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"32", "Q"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "1f526c06-1849-4c34-a13c-622fce22984a"],
 " unit squares and determines if the centroid of each square is in a \
collision. Given ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "1"], TraditionalForm]], "InlineMath",
  ExpressionUUID->"6b99e0bf-fd94-4e9c-b4e0-a6eefa1c1ef8"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "2"], TraditionalForm]], "InlineMath",
  ExpressionUUID->"adcf2792-4821-4cda-98b0-31f1ba035ed9"],
 ", the motion computation is trivial."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.6692452298275003`*^9, 3.669245249394539*^9}, {
   3.669245283123629*^9, 3.66924547235503*^9}, {3.669245669765642*^9, 
