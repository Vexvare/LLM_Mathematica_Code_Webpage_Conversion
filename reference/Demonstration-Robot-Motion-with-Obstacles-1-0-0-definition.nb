Cell["\<\
However, computing the phase-space obstacle region is more difficult, because \
the size of the space representation grows exponentially with the number of \
degrees of freedom (independent joints) of the robot.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.6692452298275003`*^9, 3.669245249394539*^9}, {
  3.669245283123629*^9, 3.66924547235503*^9}, {3.669245669765642*^9, 
  3.6692458232077827`*^9}, {3.669246845151524*^9, 3.669246848447462*^9}, {
  3.669657959957141*^9, 3.6696579648369904`*^9}, {3.669667034405334*^9, 
  3.669667061012143*^9}, {3.669667309578463*^9, 3.669667315746481*^9}},
 CellID->1867323150,ExpressionUUID->"a3694b65-462d-45fb-8ebc-e10d745a777f"],

Cell[TextData[{
 "Consider how many ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineMath",ExpressionUUID->
  "4c507d3b-48e2-4f22-9ca0-e22e5a9f71d4"],
 "-dimensional unit squares are required to fill a space of size ",
 Cell[BoxData[
  FormBox["k", TraditionalForm]], "InlineMath",ExpressionUUID->
  "eb5047c3-7821-481a-9e1a-175ac53bc276"],
 ". For a one-dimensional space, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "1"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "2e480384-c900-46a5-b218-95fa97f4039f"],
 " units are needed. For a two-dimensional space, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "2"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "916271fd-e85b-4a6b-bdd5-b6ffd0288027"],
 " squares are needed. For an ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]], "InlineMath",ExpressionUUID->
  "e9a0296c-37ec-4c5d-9423-3ebcdbc7943b"],
 "-dimensional space, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["k", "n"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "e2a437ab-4494-4786-a4cc-b87d968a4583"],
 " hypercubes would be required."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.6692452298275003`*^9, 3.669245249394539*^9}, {
  3.669245283123629*^9, 3.66924547235503*^9}, {3.669245669765642*^9, 
  3.6692458251840773`*^9}, {3.669245883752633*^9, 3.669245883756304*^9}, {
  3.669639928951211*^9, 3.669639929997717*^9}, {3.6696400209340487`*^9, 
  3.6696400650497675`*^9}, {3.669667074828133*^9, 3.669667078499709*^9}, {
  3.669667118834014*^9, 3.669667120906144*^9}, {3.669667339737939*^9, 
  3.669667342498268*^9}, {3.6697231051343193`*^9, 3.669723115039112*^9}},
 CellID->52325647,ExpressionUUID->"329004fe-f5c4-47ef-a861-6d5400990938"],

Cell[TextData[{
 "The phase space for a two-link planar robot can be represented on a torus. \
When rotation joint 1 moves past ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "c01197a9-1f6c-43dd-b043-7a0a48355d5c"],
 ", it returns to angle 0. This is represented by dashed and solid lines of \
the same color. If the phase space were printed on a rubber sheet, cut out, \
and the dashed and solid lines of each color were joined, the resulting shape \
would be a torus. In this Demonstration, moving the locator past the edge of \
the phase space wraps the angle around ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "b385386e-c482-4d98-bd55-7954af1eb758"],
 "."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.6692452298275003`*^9, 3.669245249394539*^9}, {
   3.669245283123629*^9, 3.66924547235503*^9}, {3.669245669765642*^9, 
   3.6692458251840773`*^9}, {3.669245883752633*^9, 3.669246058693239*^9}, 
   3.6695738837660313`*^9, 3.6696399305443993`*^9, 3.669639974530716*^9, 
   3.669640053774654*^9, {3.669658008854528*^9, 3.669658035630413*^9}, {
   3.6696671503451967`*^9, 3.669667245069558*^9}, {3.6696673595133*^9, 
   3.669667374512249*^9}, 3.669722956467252*^9, {3.669723146325883*^9, 
   3.669723146724594*^9}},
 CellID->1831921270,ExpressionUUID->"6f70e06a-ee43-475b-af39-2042af2243ba"]
}, Open  ]],

