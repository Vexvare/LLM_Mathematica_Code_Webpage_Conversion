Cell[TextData[{
 "This Demonstration shows a two-link planar arm robot operating in the \
workspace on the left, containing two small circular obstacles. The \
corresponding robot phase space on the right shows the configurations ",
 Cell[BoxData[
  FormBox[
   RowBox[{"q", "=", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["\[Theta]", "1"], ",", 
      SubscriptBox["\[Theta]", "2"]}], ")"}]}], TraditionalForm]], 
  "InlineMath",ExpressionUUID->"5449bc90-ee2c-4b89-8ddc-51026a8416b5"],
 " for which an arm intersects an obstacle. You can relocate an obstacle in \
the workspace and see the corresponding change in phase space. Move the \
locator in phase space vertically or horizontally to rotate the robot arms. \
The angles ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "1"], TraditionalForm]], "InlineMath",
  ExpressionUUID->"bcc38149-4917-4ef3-a728-bd7c66ad65f9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "2"], TraditionalForm]], "InlineMath",
  ExpressionUUID->"f3e82652-c938-4581-8632-c075dd90f01a"],
 " are expressed modulo ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "f196e6ba-d19f-4d67-9804-b0e03e309d66"],
 ". The obstacle regions are computed using ",
 Cell[BoxData[
  FormBox[
   RowBox[{"32", "Q"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "82e5620a-4fe7-4418-9855-93bdaaddb62c"],
 " unit squares. You can improve the quality of the computation by increasing \
",
 Cell[BoxData[
  FormBox["Q", TraditionalForm]], "InlineMath",ExpressionUUID->
  "c784190a-50d9-4172-8489-73a789dd99f2"],
 "."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.669245015833049*^9, 3.669245209427959*^9}, {
   3.6695738046024733`*^9, 3.6695738257144213`*^9}, {3.669639913665327*^9, 
