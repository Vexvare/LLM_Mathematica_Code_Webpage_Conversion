Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "returns", " ", "the", " ", "shortest", " ", "distance", " ", "between", 
    " ", "line", " ", 
    RowBox[{"segment", " ", "'"}], 
    RowBox[{"seg", "'"}], " ", "and", " ", "a", " ", "list", " ", "of", " ", 
    "points"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pointsegdis2", "[", 
      RowBox[{"{", 
       RowBox[{"seg_", ",", "pointlist_"}], "}"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"u", "=", 
          RowBox[{"Subtract", "@@", "seg"}]}], ",", 
         RowBox[{"mean", "=", 
          RowBox[{
           RowBox[{"Plus", "@@", "seg"}], "/", "2"}]}]}], "}"}], ",", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"EuclideanDistance", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"mean", "-", 
                RowBox[{"u", " ", 
                 RowBox[{"Sign", "@", "#"}], " ", 
                 RowBox[{
                  RowBox[{"Min", "[", 
                   RowBox[{"1", ",", 
                    RowBox[{"Abs", "@", "#"}]}], "]"}], "/", "2"}]}]}], ")"}],
               "&"}], "@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{"2", " ", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"#", "-", "mean"}], ")"}], ".", "u"}]}], ")"}]}], 
               "/", 
               RowBox[{"u", ".", "u"}]}], ")"}]}]}], "]"}], "&"}], "/@", 
         "pointlist"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"isCollided", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"seg_", ",", "pointlist_"}], "}"}], ",", " ", "d_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"u", "=", 
          RowBox[{"Subtract", "@@", "seg"}]}], ",", 
         RowBox[{"mean", "=", 
          RowBox[{
           RowBox[{"Plus", "@@", "seg"}], "/", "2"}]}]}], "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"EuclideanDistance", "[", 
               RowBox[{"#", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"mean", "-", 
                    RowBox[{"u", " ", 
                    RowBox[{"Sign", "@", "#"}], " ", 
                    RowBox[{
                    RowBox[{"Min", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"Abs", "@", "#"}]}], "]"}], "/", "2"}]}]}], ")"}],
                   "&"}], "@", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"2", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"#", "-", "mean"}], ")"}], ".", "u"}]}], ")"}]}], 
                   "/", 
                   RowBox[{"u", ".", "u"}]}], ")"}]}]}], "]"}], "&"}], "/@", 
             "pointlist"}], "]"}], "<", "d"}], ")"}], ",", "1", ",", "0"}], 
        "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"to", " ", "space", " ", "the", " ", "overlay", " ", "plot"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xMin", " ", "=", " ", "2.9"}], ";", 
    RowBox[{"yMin", " ", "=", 
     RowBox[{"-", "2"}]}], ";", 
    RowBox[{"xMax", "=", 
     RowBox[{"xMin", "+", "3.8"}]}], ";", 
    RowBox[{"yMax", "=", 
     RowBox[{"yMin", "+", "3.8"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"a", " ", "colored", " ", "locator", " ", "icon"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"loc", "[", "col_", "]"}], ":=", 
     RowBox[{"ToExpression", "@", 
      RowBox[{"GraphicsBox", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"col", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
            RowBox[{"Antialiasing", "\[Rule]", "False"}], ",", 
            RowBox[{"LineBox", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", 
                   RowBox[{"-", "10"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", 
                   RowBox[{"-", "2"}]}], "}"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "2"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "10"}], "}"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "10"}], ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "2"}], ",", "0"}], "}"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"2", ",", "0"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"10", ",", "0"}], "}"}]}], "}"}]}], "}"}], "]"}], 
            ",", 
            RowBox[{"Antialiasing", "\[Rule]", "True"}], ",", 
            RowBox[{"CircleBox", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", "5"}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"AbsoluteThickness", "[", "3", "]"}], ",", 
            RowBox[{"Opacity", "[", "0.3", "]"}], ",", 
            RowBox[{"CircleBox", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "0.5"}], ",", "0.5"}], "}"}], ",", "3"}], 
             "]"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "17"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "8"}], ",", "8"}], "}"}]}], "}"}]}]}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "draw", " ", "circular", " ", "arcs", " ", "with", " ", "arrowheads"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"arrowArc", "[", "s_Circle", "]"}], ":=", 
     RowBox[{"s", "/.", 
      RowBox[{
       RowBox[{"Circle", "[", 
        RowBox[{"a_", ",", "r_", ",", 
         RowBox[{"{", 
          RowBox[{"start_", ",", "end_"}], "}"}]}], "]"}], "\[RuleDelayed]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"s", ",", 
            RowBox[{"Arrow", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "-", 
                RowBox[{
                 RowBox[{"r", "/", 
                  RowBox[{"10", "^", "6"}]}], " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", 
                    RowBox[{"Sin", "@", "end"}]}], ",", 
                   RowBox[{"Cos", "@", "end"}]}], "}"}]}]}], ",", "#"}], 
              "}"}], "]"}]}], "}"}], "&"}], "[", 
         RowBox[{"a", "+", 
          RowBox[{"r", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "@", "end"}], ",", 
             RowBox[{"Sin", "@", "end"}]}], "}"}]}]}], "]"}], ")"}]}]}]}], 
    ";"}], "\[IndentingNewLine]"}]}]], "Input",
 TaggingRules->{},
 InitializationCell->True,
 CellChangeTimes->{
  3.669462551408827*^9, {3.669548063723463*^9, 3.66954808678996*^9}, {
   3.669548199801935*^9, 3.669548200496747*^9}, {3.669548576677012*^9, 
   3.669548604501628*^9}, {3.66954866150902*^9, 3.669548662757201*^9}, {
   3.669548703570795*^9, 3.66954876522853*^9}, {3.66954880302131*^9, 
