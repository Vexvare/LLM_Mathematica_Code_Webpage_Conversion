Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"w", " ", "=", " ", 
        RowBox[{"1", "/", "8"}]}], ",", 
       RowBox[{"l", "=", "1"}], ",", "\[Theta]1", " ", ",", "\[Theta]2", ",", 
       "inCollision", ",", "pObsV", ",", " ", "resolution"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"enable", " ", "torus", " ", "property"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "pConfig", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "<", "xMin"}], ",", 
        RowBox[{
         RowBox[{
         "pConfig", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "=", "xMax"}]}], "]"}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "pConfig", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         ">", "xMax"}], ",", 
        RowBox[{
         RowBox[{
         "pConfig", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
         "=", "xMin"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "pConfig", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         "<", "yMin"}], ",", 
        RowBox[{
         RowBox[{
         "pConfig", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         "=", "yMax"}]}], "]"}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
         "pConfig", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         ">", "yMax"}], ",", 
        RowBox[{
         RowBox[{
         "pConfig", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
         "=", "yMin"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Theta]1", " ", "=", " ", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{
          "pConfig", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
          "-", "xMin"}], 
         RowBox[{"xMax", "-", "xMin"}]], "2", "\[Pi]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Theta]2", " ", "=", " ", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{
          "pConfig", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
          "-", "yMin"}], 
         RowBox[{"yMax", "-", "yMin"}]], "2", "\[Pi]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"pObsV", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"pObs", ",", "pObs2"}], "}"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"position", " ", "vector", " ", "for", " ", "Obstacles"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"inCollision", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"pointsegdis2", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}], ",", 
              RowBox[{"l", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Cos", "[", "\[Theta]1", "]"}], ",", 
                 RowBox[{"Sin", "[", "\[Theta]1", "]"}]}], "}"}]}]}], "}"}], 
            ",", "pObsV"}], "}"}], "]"}], "<", 
         RowBox[{"2", "w"}]}], "||", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"pointsegdis2", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"l", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Cos", "[", "\[Theta]1", "]"}], ",", 
